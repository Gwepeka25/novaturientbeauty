# Copy this file to .env and fill in real values. Never commit .env.

# Local dev: SQLite file. Production (Render): a PostgreSQL connection string.
DATABASE_URL="file:./dev.db?pool_timeout=20"

# Public base URL of the site (used in emails, canonical URLs, sitemap).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Long random string used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Resend (https://resend.com) free tier for transactional email.
RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="Michelle Ihirwe <no-reply@example.com>"

# Used only by `npm run db:seed` to create the first admin login.
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_NAME="Kay"
