// Prisma schema for Michelle Ihirwe's booking site.
//
// PostgreSQL everywhere — the same database (Render Postgres) is used for
// local development and production, so there is only one schema and one
// migration history to keep in sync. This schema intentionally avoids
// Postgres-only features (enums, arrays, native JSON operators) it doesn't
// need, so nothing here is hard to reason about even though it isn't
// SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  calendarFeedToken String? @unique // secret token for the subscribable .ics feed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditEvents AuditEvent[]
}

model Service {
  id            String   @id @default(cuid())
  name          String
  description   String
  durationMin   Int
  priceCents    Int
  currency      String   @default("EUR")
  format        String // "in_person" | "online" | "both"
  active        Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  packages        Package[]
}

// Recurring weekly availability, e.g. "Tuesdays 09:00-17:00". One row per
// weekday — enforced at the DB level so a double-submitted admin form can
// never create overlapping/duplicate hours for the same day.
model AvailabilityRule {
  id          String   @id @default(cuid())
  weekday     Int      @unique // 0 = Sunday ... 6 = Saturday
  startMinute Int // minutes from midnight, local Europe/Brussels time
  endMinute   Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One-off exceptions: extra availability, holidays, or blocked time ranges.
model AvailabilityException {
  id        String   @id @default(cuid())
  date      String // "YYYY-MM-DD" in Europe/Brussels local date
  startMinute Int?   // null + isFullDayBlock = whole day blocked
  endMinute   Int?
  isFullDayBlock Boolean @default(false)
  kind      String // "block" | "extra_availability" | "holiday"
  formatRestriction String? // null = applies to both formats; "in_person" | "online" = only that format is affected, so the other stays bookable
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchedulingSettings {
  id                       String   @id @default(cuid())
  timezone                 String   @default("Europe/Brussels")
  minNoticeMinutes         Int      @default(1440)
  maxAdvanceDays           Int      @default(60)
  bufferBeforeMinutes      Int      @default(0)
  bufferAfterMinutes       Int      @default(15)
  cancellationCutoffMinutes Int     @default(1440)
  updatedAt                DateTime @updatedAt
}

model Appointment {
  id               String   @id @default(cuid())
  publicCode       String   @unique // short opaque reference shown to client
  serviceId        String
  service          Service  @relation(fields: [serviceId], references: [id])
  format           String // "in_person" | "online"
  startsAt         DateTime // stored in UTC
  endsAt           DateTime // stored in UTC, startsAt + duration
  status           String   @default("pending") // pending|confirmed|completed|cancelled_by_client|cancelled_by_practitioner|no_show
  priceCentsAtBooking Int? // snapshot of the service's price when booked, so
                            // a later price change never rewrites financial
                            // history. Null on rows created before this field
                            // existed — reporting falls back to the current
                            // service price for those.
  clientName       String
  clientEmail      String
  clientPhone      String?
  clientNote       String? // optional, never required
  locale           String   @default("en") // "en" | "fr" | "nl" — the client's chosen
                                             // language at booking time, so later emails
                                             // (reminder, receipt, etc.) can be sent in it
  privateOpsNote   String? // admin-only operational note, never clinical
  clientVisibleNote String? // optional take-away written by the practitioner
                             // after a session, shown to the client in the
                             // portal — never clinical, the client's choice
                             // to read it
  cashPaid         Boolean  @default(false)
  paidOnlineAt     DateTime? // set once a Stripe checkout for this appointment is confirmed paid
  stripeCheckoutSessionId String? @unique
  onlineMeetingUrl String? // only set/sent after confirmation
  manageToken      String   @unique // secure token for reschedule/cancel links
  manageTokenExp   DateTime
  packageId        String? // set if this session was covered by a pre-paid
                            // package rather than paid for individually
  package          Package? @relation(fields: [packageId], references: [id])
  giftCodeId       String? // set if this session was covered by a redeemed gift code
  giftCode         GiftCode? @relation(fields: [giftCodeId], references: [id])
  reminderSentAt   DateTime? // set once the day-before reminder email has gone out
  reengagementSentAt DateTime? // set once a lapsed-client "it's been a while" email has
                                // gone out for this being the client's most recent
                                // appointment. A later booking makes a newer row the
                                // client's most recent one instead, naturally
                                // re-arming eligibility without touching this field.
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reviewInvite ReviewInvite?
  auditEvents  AuditEvent[]

  @@index([startsAt])
  @@index([status])
  @@index([clientEmail])
}

model ReviewInvite {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  token         String   @unique
  tokenExp      DateTime
  usedAt        DateTime?
  createdAt     DateTime @default(now())

  review Review?
}

model Review {
  id              String   @id @default(cuid())
  reviewInviteId  String?  @unique
  reviewInvite    ReviewInvite? @relation(fields: [reviewInviteId], references: [id])
  displayNameMode String   @default("anonymous") // "first_name" | "initials" | "anonymous"
  displayName     String? // resolved public label, set at submission time
  body            String
  consentPublic   Boolean  @default(false)
  status          String   @default("pending") // pending|approved|hidden|rejected|withdrawn
  isLegacy        Boolean  @default(false) // manually-entered testimonial predating verified reviews
  publishOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WebsiteContent {
  id        String   @id @default(cuid())
  key       String // e.g. "hero.eyebrow", "about.bio"
  locale    String   @default("en") // "en" | "fr" | "nl"
  value     String
  approved  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
}

// Editable copy for outgoing transactional emails (see
// src/lib/email-template-defaults.ts for the compiled-in default subject/
// body per key, and available {{variable}} placeholders). Same
// approve-to-publish pattern as WebsiteContent: an unapproved or missing row
// falls back to the default, so a bad edit can never break outgoing mail.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String // e.g. "booking_confirmation"
  locale    String   @default("en") // "en" | "fr" | "nl"
  subject   String
  bodyHtml  String
  approved  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
}

// Business expenses, entered manually by the admin — there is no bank
// integration. Used purely for profit reporting in /admin/finances.
model Expense {
  id          String   @id @default(cuid())
  date        String // "YYYY-MM-DD", the date the expense applies to
  category    String // "rent" | "supplies" | "marketing" | "software" | "insurance" | "training" | "other"
  description String
  amountCents Int
  currency    String   @default("EUR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

// Passwordless login for the client portal (/portal) — a client requests a
// link by email, we email a single-use token instead of maintaining
// passwords for people who booked a handful of sessions.
model ClientLoginToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// A client asked to be told if a slot opens up on a date that had none
// available. Created from the booking flow when a date/format search comes
// back empty; resolved by notifyWaitlistForOpening() when a matching
// appointment is cancelled.
model WaitlistEntry {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  format      String // "in_person" | "online"
  date        String // "YYYY-MM-DD" in Europe/Brussels local date
  clientName  String
  clientEmail String
  clientPhone String?
  note        String?
  locale      String   @default("en") // "en" | "fr" | "nl"
  status      String   @default("pending") // pending|notified|cancelled
  notifiedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([date, serviceId, format, status])
}

// A block of pre-paid sessions, recorded by the admin after being paid in
// cash or by bank transfer — there's no online payment on this site, so
// this mirrors how every other payment here is handled. Bookings for a
// matching, still-eligible client automatically consume one session
// (see src/lib/packages.ts); cancelling one gives the session back.
model Package {
  id             String    @id @default(cuid())
  clientEmail    String
  clientName     String
  serviceId      String? // null = valid for any service
  service        Service?  @relation(fields: [serviceId], references: [id])
  totalSessions  Int
  usedSessions   Int       @default(0)
  priceCentsPaid Int
  currency       String    @default("EUR")
  purchasedAt    DateTime  @default(now())
  note           String? // e.g. how it was paid
  active         Boolean   @default(true) // admin can void a package
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  appointments Appointment[]

  @@index([clientEmail])
}

// A single-use voucher, issued by the admin after being paid in cash or by
// bank transfer (same reasoning as Package — no online payment on this
// site). Anyone who has the code can redeem it toward one booking, full
// value only (no partial redemption/change) — see src/lib/gift-codes.ts.
model GiftCode {
  id             String    @id @default(cuid())
  code           String    @unique
  amountCents    Int
  currency       String    @default("EUR")
  purchaserName  String?
  purchaserEmail String?
  recipientNote  String? // optional message for whoever redeems it
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime?
  redeemedAt     DateTime?
  active         Boolean   @default(true) // admin can void an unredeemed code
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  appointments Appointment[]
}

// A scheduled group session with a fixed number of spots — a different
// shape from Appointment (many attendees per slot, not one). Payment is
// per-registration: cash by default, or online via Stripe once configured
// (see src/lib/stripe.ts) — same dormant-until-configured pattern as the
// rest of the site.
model Workshop {
  id           String   @id @default(cuid())
  title        String
  description  String
  startsAt     DateTime // UTC
  endsAt       DateTime // UTC
  format       String // "in_person" | "online"
  location     String? // address or meeting link, shown to registrants
  capacity     Int
  priceCents   Int
  currency     String   @default("EUR")
  active       Boolean  @default(true) // admin can unpublish without deleting history
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registrations WorkshopRegistration[]

  @@index([startsAt])
}

model WorkshopRegistration {
  id             String    @id @default(cuid())
  workshopId     String
  workshop       Workshop  @relation(fields: [workshopId], references: [id])
  clientName     String
  clientEmail    String
  clientPhone    String?
  locale         String    @default("en")
  status         String    @default("confirmed") // confirmed | cancelled_by_client | cancelled_by_practitioner
  cashPaid       Boolean   @default(false)
  paidOnlineAt   DateTime?
  stripeCheckoutSessionId String? @unique
  manageToken    String    @unique
  manageTokenExp DateTime
  registeredAt   DateTime  @default(now())

  @@index([workshopId])
  @@index([clientEmail])
}

model AuditEvent {
  id            String   @id @default(cuid())
  actorId       String?
  actor         AdminUser? @relation(fields: [actorId], references: [id])
  action        String // e.g. "appointment.status_changed", "admin.sign_in"
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  metadata      String? // small JSON string, never sensitive/clinical content
  createdAt     DateTime @default(now())

  @@index([createdAt])
}
